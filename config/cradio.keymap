#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

// Home row mods macro
// #define HRML(k1,k2,k3,k4) &ht LSHFT k1  &ht LALT k2  &ht LCTRL k3  &ht LGUI k4
// #define HRMR(k1,k2,k3,k4) &ht RGUI k1  &ht RCTRL k2  &ht RALT k3  &ht RSHFT k4

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
};

/ {
    conditional_layers { compatible = "zmk,conditional-layers"; };

    combos {
        compatible = "zmk,combos";

        combo-meta-layer {
            bindings = <&mo 4>;
            key-positions = <31 32>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&kp Q         &kp W        &kp E       &kp R             &kp T    &kp Y        &kp U  &kp I       &kp O        &kp P
&mt LSHIFT A  &mt LCTRL S  &mt LALT D  &kp F             &kp G    &kp H        &kp J  &mt RALT K  &mt RCTRL L  &mt RSHIFT COLON
&kp Z         &kp X        &kp C       &kp V             &kp B    &kp N        &kp M  &kp COMMA   &kp DOT      &kp FSLH
                                       &kp LEFT_COMMAND  &mo 1    &lt 2 SPACE  &mo 3
            >;
        };

        left-thumb {
            bindings = <
&kp EXCLAMATION        &kp AT_SIGN           &kp HASH                  &kp DOLLAR        &kp PERCENT      &kp CARET  &kp AMPERSAND   &kp ASTERISK   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&mt LEFT_SHIFT ESCAPE  &mt LCTRL LEFT_BRACE  &mt LEFT_ALT RIGHT_BRACE  &kp GRAVE         &kp SEMICOLON    &kp PIPE   &kp UNDERSCORE  &mt RALT PLUS  &kp LCTRL             &kp RSHFT
&trans                 &trans                &trans                    &trans            &trans           &trans     &trans          &trans         &trans                &trans
                                                                       &kp LEFT_COMMAND  &trans           &trans     &trans
            >;
        };

        right-deep-thumb {
            bindings = <
&kp TAB    &trans     &trans    &trans     &trans    &trans    &trans    &trans  &trans     &kp BSPC
&kp LSHFT  &kp LCTRL  &kp LALT  &kp TILDE  &trans    &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &kp RET
&trans     &trans     &trans    &trans     &trans    &trans    &trans    &trans  &trans     &trans
                                &kp LGUI   &trans    &trans    &trans
            >;
        };

        right-thumb {
            bindings = <
&kp N1     &kp N2     &kp N3    &kp N4    &kp N5    &kp N6          &kp N7     &kp N8          &kp N9                          &kp N0
&kp LSHFT  &kp LCTRL  &kp LALT  &kp SQT   &trans    &kp UNDERSCORE  &kp MINUS  &mt RALT EQUAL  &mt RIGHT_CONTROL LEFT_BRACKET  &mt RSHIFT RIGHT_BRACKET
&trans     &trans     &trans    &trans    &trans    &trans          &trans     &trans          &trans                          &trans
                                &kp LGUI  &trans    &trans          &trans
            >;
        };

        meta {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans      &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &trans  &sys_reset
&trans        &trans        &trans        &trans        &trans          &kp K_MUTE  &kp C_VOLUME_DOWN     &kp C_VOLUME_UP       &trans  &bootloader
&trans        &trans        &trans        &trans        &trans          &trans      &trans                &trans                &trans  &trans
                                          &trans        &trans          &trans      &trans
            >;
        };
    };
};
